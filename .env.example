# ─────────────────────────────────────────────────────────────
# Anvayam Vaidya Sala — environment configuration
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.org

# ── Public contact details (shown on the site; leave empty to hide) ──
# Do not fill these in until the official details are confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ── Privacy policy (footer + form link appear only when set) ──
# Full URL or a site path such as /privacy
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# ── Social media (each link appears only when a real, maintained URL is set) ──
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# ── Contact form delivery (SERVER-ONLY secrets — no NEXT_PUBLIC_ prefix) ──
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate multiple addresses)
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Anvayam Website <website@your-domain>"
CONTACT_FROM_EMAIL=
